<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ApplicationGroupContainerIdentifier</key>
	<string>group.com.shahidy.hexkeyboard</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>FooterText</key>
			<string>A row of digits above the letters. The keyboard grows taller to fit it.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<false/>
			<key>Key</key>
			<string>numberRow</string>
			<key>Title</key>
			<string>Number Row</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Opens every emoji from beside the space bar. Without it, the emoji for the word you type still show at the right of the suggestions; swipe them left for more.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<true/>
			<key>Key</key>
			<string>emojiKey</string>
			<key>Title</key>
			<string>Emoji Key</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>The skin tone emoji take until you pick another for one by holding it.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string></string>
			<key>Key</key>
			<string>skinTone</string>
			<key>Title</key>
			<string>Skin Tone</string>
			<key>Titles</key>
			<array>
				<string>Default</string>
				<string>Light</string>
				<string>Medium Light</string>
				<string>Medium</string>
				<string>Medium Dark</string>
				<string>Dark</string>
			</array>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Values</key>
			<array>
				<string></string>
				<string>light</string>
				<string>mediumLight</string>
				<string>medium</string>
				<string>mediumDark</string>
				<string>dark</string>
			</array>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Shows emoji and GIFs in one row that scrolls sideways, as in landscape, so the keyboard stays short when you hold the iPhone upright.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<false/>
			<key>Key</key>
			<string>compactPanels</string>
			<key>Title</key>
			<string>Compact Emoji &amp; GIFs</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>On the open iPhone Duo held wide, half the keys sit under each thumb. You can also hold 123 and slide, or tap … above the keys.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<false/>
			<key>Key</key>
			<string>split</string>
			<key>Title</key>
			<string>Split Keyboard</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Moves the keys toward one thumb while the iPhone is upright. You can also hold 123 and slide.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string>off</string>
			<key>Key</key>
			<string>oneHanded</string>
			<key>Title</key>
			<string>One-Handed Keyboard</string>
			<key>Titles</key>
			<array>
				<string>Off</string>
				<string>Left</string>
				<string>Right</string>
			</array>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Values</key>
			<array>
				<string>off</string>
				<string>left</string>
				<string>right</string>
			</array>
		</dict>
	</array>
	<key>Title</key>
	<string>Layout</string>
</dict>
</plist>
