<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ApplicationGroupContainerIdentifier</key>
	<string>group.com.shahidy.hexkeyboard</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>FooterText</key>
			<string>What shows above your thumb as you press a key: the letter in a bubble of its own, or the key grown up into it, as on Apple’s keyboard.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string>attached</string>
			<key>Key</key>
			<string>characterPreviewStyle</string>
			<key>Title</key>
			<string>Character Preview</string>
			<key>Titles</key>
			<array>
				<string>None</string>
				<string>Detached</string>
				<string>Attached</string>
			</array>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Values</key>
			<array>
				<string>none</string>
				<string>detached</string>
				<string>attached</string>
			</array>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Each key taps back, as Apple’s keyboard does, once Hex has Full Access.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string>standard</string>
			<key>Key</key>
			<string>hapticFeedback</string>
			<key>Title</key>
			<string>Haptic Feedback</string>
			<key>Titles</key>
			<array>
				<string>Off</string>
				<string>Soft</string>
				<string>Standard</string>
			</array>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Values</key>
			<array>
				<string>off</string>
				<string>soft</string>
				<string>standard</string>
			</array>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Plays the key click while Keyboard Clicks is on in Settings › Sounds &amp; Haptics.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<true/>
			<key>Key</key>
			<string>sound</string>
			<key>Title</key>
			<string>Sound</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
	</array>
	<key>Title</key>
	<string>Feedback</string>
</dict>
</plist>
