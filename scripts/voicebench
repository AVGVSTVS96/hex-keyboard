#!/bin/sh
# Scores iikb's dictation path against FluidAudio's own on a corpus of real dictations, at full loudness and 10 and 30
# times quieter: scripts/voicebench <corpus>, where <corpus> holds clips.jsonl ({id, audio_path}), the audio and
# references.jsonl ({id, text}). Runs Tools/VoiceBench on the Mac (Neural Engine) and scores here (scripts/voicescore.py).
set -e
[ -d "$1" ] || { echo "usage: scripts/voicebench <corpus>" >&2; exit 1; }
cd "$(dirname "$0")/.."
rsync -aL --delete --exclude .build Tools/VoiceBench/ mac:Developer/voicebench/tool/
rsync -a --exclude outputs "$1"/ mac:Developer/voicebench/corpus/
ssh mac 'cd ~/Developer/voicebench && swift build -c release --package-path tool >/dev/null &&
  for way in asis dictation; do for loudness in 100 10 3; do tool/.build/release/VoiceBench corpus $way $loudness; done; done'
rsync -a mac:Developer/voicebench/corpus/outputs/ "$1"/outputs/
python3 -I scripts/voicescore.py "$1"
