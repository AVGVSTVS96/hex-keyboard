#!/bin/bash
# Runs on the Mac. Everything a batch of changes needs, at once, on one simulator, the iPhone Duo folded unless named:
# one build of the app and every test, KeyboardUI's package tests, every UI test with Full Access on the
# simulator (each test capped at 2 minutes, a failure retried once), the voice test with scripts/voiceapp.py standing in
# for the app, and the screenshot tests again in dark, into shots/raw/verify/.
# scripts/verify ["iPhone 17"] [iPhone-17] (OPEN=1 unfolds; ORIENTATION=landscape)
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
export APP=build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
ID=$(scripts/sim ensure "$NAME" "$TYPE")
shots=$PWD/shots/raw/verify
logs=build/uitest/verify
rm -rf "$shots" "$logs"
mkdir -p "$shots" "$logs"
step() { echo "== $1 $(date +%T)"; }
summary() { grep -E "error:|✘|XCTAssert|Test [Cc]ase .*failed|Test run with|Executed .* tests" "$1" | sort -u || true; }

step build
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet

scripts/sim boot "$ID"
scripts/sim allow "$ID"
scripts/sim use "$ID" iikb
[ -n "${OPEN:-}" ] && scripts/sim unfold "$ID"
group=$(xcrun simctl get_app_container "$ID" com.shahidy.iikb group.com.shahidy.iikb)

uitest() {
  local log=$logs/$1.log; shift
  mkdir -p "$prefix"
  TEST_RUNNER_IIKB_SHOTS=$prefix TEST_RUNNER_IIKB_ORIENTATION=${ORIENTATION:-portrait} \
    xcodebuild test-without-building -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
    -derivedDataPath build/uitest -test-timeouts-enabled YES -default-test-execution-time-allowance 120 \
    -retry-tests-on-failure -test-iterations 2 -collect-test-diagnostics never "$@" > "$log" 2>&1 || failed=1
  summary "$log"
}

step "package tests"
prefix=$shots/package
uitest package -only-testing:KeyboardUITests -skip-testing:KeyboardUITests/Evaluation

for appearance in light dark; do
  scripts/sim boot "$ID"
  xcrun simctl ui "$ID" appearance "$appearance"
  prefix=$shots/$appearance/iikb
  step "ui tests, $appearance"
  if [ "$appearance" = light ]; then
    uitest light -only-testing:AppUITests -skip-testing:AppUITests/VoiceTests
  else
    uitest dark -only-testing:AppUITests/PanelTests -only-testing:AppUITests/ToolPanelTests -only-testing:AppUITests/SuggestionShots
  fi
  step "voice test, $appearance"
  /usr/bin/python3 scripts/voiceapp.py "$ID" "$group" &
  app=$!
  uitest "voice-$appearance" -only-testing:AppUITests/VoiceTests
  kill "$app" 2>/dev/null || true
  wait "$app" 2>/dev/null || true
done
step "done, $([ -z "${failed:-}" ] && echo passed || echo failed)"
exit "${failed:-0}"
