#!/bin/sh
# Builds Hex on this Linux box with xtool and signs it for the free team's devices (its one development certificate
# lives with xtool here), then installs it through the Mac on the iPhone the Mac reaches, by cable or Wi-Fi, once no
# dictation is going on there: Hex writes a dictation's recording as it's heard, so one written in the last 10 seconds
# is still going. Then it starts Hex in the background, so Parakeet compiles for the new install right away.
# It builds the last commit in its own worktree, so agents' uncommitted edits in this checkout never reach the phone,
# and one run at a time, so agents installing at once queue instead of sharing that worktree.
set -e
cd "$(dirname "$0")/.."
build=../hex-keyboard-build
exec 9>"$build.lock"
flock 9
[ -d "$build" ] || git worktree add -q --detach "$build"
git -C "$build" checkout -q --detach "$(git rev-parse HEAD)"
key=Packages/HexKeyboard/Sources/KeyboardUI/Resources/Keys/klipy.key
[ ! -f "$key" ] || cp "$key" "$build/$key"
cd "$build"
xtool dev build -c release --sign
for binary in xtool/Hex.app/Hex xtool/Hex.app/PlugIns/Keyboard.appex/Keyboard; do
  sdk=$(llvm-otool -l "$binary" | awk '/LC_BUILD_VERSION/ {b=1} b && $1 == "sdk" {print $2; exit}')
  [ "$(printf '%s\n27.1\n' "$sdk" | sort -V | head -1)" = 27.1 ] || {
    echo "$binary is linked against iOS SDK $sdk; below 27.1 the iPhone Duo runs Hex as an old iPhone app (AGENTS.md, scripts/phone)" >&2
    exit 1
  }
done
phone=$(ssh mac 'xcrun devicectl list devices --json-output /tmp/hex-phone.json >/dev/null && /usr/bin/python3 -c "
import json
for d in json.load(open(\"/tmp/hex-phone.json\"))[\"result\"][\"devices\"]:
    h, c = d[\"hardwareProperties\"], d[\"connectionProperties\"]
    if h.get(\"deviceType\") == \"iPhone\" and h.get(\"reality\") == \"physical\" and c.get(\"transportType\"): print(h[\"udid\"]); break"')
[ -n "$phone" ] || { echo "the Mac doesn't reach an iPhone" >&2; exit 1; }
rsync -a --delete xtool/Hex.app/ mac:Developer/hex-keyboard-phone/Hex.app/
dictating() {
  ssh mac sh -s "$phone" <<'MAC'
xcrun devicectl device info files --device "$1" --domain-type appDataContainer --domain-identifier com.shahidy.hexkeyboard \
  --subdirectory "Library/Application Support/recordings" --json-output /tmp/hex-recordings.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "
import datetime, json, sys
now = datetime.datetime.now(datetime.timezone.utc)
files = json.load(open('/tmp/hex-recordings.json'))['result']['files']
sys.exit(0 if any((now - datetime.datetime.fromisoformat(f['metadata']['lastModDate'].replace('Z', '+00:00'))).total_seconds() < 10 for f in files) else 1)"
MAC
}
while dictating; do
  echo "waiting for the dictation on the iPhone to end, since an install would cut it off" >&2
  sleep 2
done
ssh mac xcrun devicectl device install app --device "$phone" Developer/hex-keyboard-phone/Hex.app
ssh mac xcrun devicectl device process launch --no-activate --device "$phone" com.shahidy.hexkeyboard >/dev/null ||
  echo "Hex is installed but didn't start, so Parakeet gets ready at the next dictation instead" >&2
