#!/bin/sh
# Builds Hex on this Linux box with xtool and signs it for the free team's devices (its one development certificate
# lives with xtool here), then installs it through the Mac on the iPhone the Mac reaches, by cable or Wi-Fi.
set -e
cd "$(dirname "$0")/.."
xtool dev build -c release --sign
for binary in xtool/Hex.app/Hex xtool/Hex.app/PlugIns/Keyboard.appex/Keyboard; do
  sdk=$(llvm-otool -l "$binary" | awk '/LC_BUILD_VERSION/ {b=1} b && $1 == "sdk" {print $2; exit}')
  [ "$(printf '%s\n27.1\n' "$sdk" | sort -V | head -1)" = 27.1 ] || {
    echo "$binary is linked against iOS SDK $sdk; below 27.1 the iPhone Duo runs Hex as an old iPhone app (AGENTS.md, scripts/phone)" >&2
    exit 1
  }
done
phone=$(ssh mac 'xcrun devicectl list devices --json-output /tmp/hex-phone.json >/dev/null && /usr/bin/python3 -c "
import json
for d in json.load(open(\"/tmp/hex-phone.json\"))[\"result\"][\"devices\"]:
    h, c = d[\"hardwareProperties\"], d[\"connectionProperties\"]
    if h.get(\"deviceType\") == \"iPhone\" and h.get(\"reality\") == \"physical\" and c.get(\"transportType\"): print(h[\"udid\"]); break"')
[ -n "$phone" ] || { echo "the Mac doesn't reach an iPhone" >&2; exit 1; }
rsync -a --delete xtool/Hex.app/ mac:Developer/hex-keyboard-phone/Hex.app/
ssh mac xcrun devicectl device install app --device "$phone" Developer/hex-keyboard-phone/Hex.app
