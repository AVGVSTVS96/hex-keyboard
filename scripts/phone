#!/bin/sh
# Builds Hex on this Linux box with xtool and provisions it for the free team's devices. The team holds one development
# certificate, and it's the Mac's: xtool's identity (~/.config/xtool/data/<team>) holds that certificate without its
# key, so xtool (Bassim's fork) makes the profiles for it and signs ad hoc, and scripts/resign signs on the Mac, whose
# login keychain has the key.
# Never let xtool revoke a certificate to make its own: that breaks what the Mac signs (stdin is closed, so it can't ask).
# Then it backs up the phone's iikb data here (scripts/backup), and won't install without that backup, and installs it
# through the Mac on the iPhone the Mac reaches, by cable or Wi-Fi, once no dictation is being recorded or written down
# there, as the running app's status in the App Group says, checked last thing before the install.
# Then it starts Hex in the background, now or the moment the iPhone next unlocks (scripts/unlocked), so Parakeet
# compiles for the new install right away rather than at the next dictation.
# It builds main's last commit in its own worktree, so agents' branches and uncommitted edits never reach the phone,
# and one run at a time, so agents installing at once queue instead of sharing that worktree. The build number is main's
# commit count, which Settings › About shows as "Version 0.1.0 (<build>)"; when the iPhone already has that build,
# nothing is built or installed, sparing it the Neural Engine compile, unless --reinstall (which renews the signing).
# Its build doesn't wait for a turn (~/.local/bin/turn): installs go out the moment main is ready, one at a time by
# this script's own lock, and a build that waited for a turn while holding it could wait on runs queued behind it.
# Installs go out at most once every 10 minutes: a run soon after the last install waits out the rest, then installs
# main as it is by then, so builds that finish meanwhile land as one batch and the runs queued behind it find their
# build already on the iPhone. --now skips the wait.
set -e
cd "$(dirname "$0")/.."
build=../hex-keyboard-build
exec 9>"$build.lock"
flock 9
stamp=$build.installed
wait=$(( ${PHONE_EVERY:-600} - $(date +%s) + $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
if [ "$wait" -gt 0 ] && [ "${1:-}" != --now ]; then
  echo "the last install was under 10 minutes ago, so this one installs main as it is in ${wait}s, with whatever lands meanwhile" >&2
  sleep "$wait"
fi
[ -d "$build" ] || git worktree add -q --detach "$build"
commit=$(git rev-parse --short main)
number=$(git rev-list --count main)
phone=$(ssh mac 'xcrun devicectl list devices --json-output /tmp/hex-phone.json >/dev/null && /usr/bin/python3 -c "
import json
for d in json.load(open(\"/tmp/hex-phone.json\"))[\"result\"][\"devices\"]:
    h, c = d[\"hardwareProperties\"], d[\"connectionProperties\"]
    if h.get(\"deviceType\") == \"iPhone\" and h.get(\"reality\") == \"physical\" and c.get(\"transportType\"): print(h[\"udid\"]); break"')
[ -n "$phone" ] || { echo "the Mac doesn't reach an iPhone" >&2; exit 1; }
installed=$(ssh mac sh -s "$phone" <<'MAC'
xcrun devicectl device info apps --device "$1" --bundle-id com.shahidy.hexkeyboard --json-output /tmp/hex-apps.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "import json; print(next((a.get('bundleVersion', '') for a in json.load(open('/tmp/hex-apps.json'))['result']['apps']), ''))"
MAC
)
if [ "$installed" = "$number" ] && [ "${1:-}" != --reinstall ]; then
  echo "build $number (main $commit) is already on the iPhone"
  exit 0
fi
git -C "$build" checkout -q -f --detach "$commit"
for plist in Config/xtool/Hex-Info.plist Config/xtool/Keyboard-Info.plist; do
  python3 -c "import plistlib, sys; p = plistlib.load(open(sys.argv[1], 'rb')); p['CFBundleVersion'] = sys.argv[2]; plistlib.dump(p, open(sys.argv[1], 'wb'))" "$build/$plist" "$number"
done
keys=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/Packages/HexKeyboard/Sources/KeyboardUI/Resources/Keys
[ -f "$keys/backup.key" ] || { echo "$keys/backup.key is missing, so this build wouldn't back up the iPhone's iikb data (docs/backup.md)" >&2; exit 1; }
cp "$keys"/*.key "$build/Packages/HexKeyboard/Sources/KeyboardUI/Resources/Keys/"
cd "$build"
TURN=phone xtool dev build -c release --sign < /dev/null
for binary in xtool/Hex.app/Hex xtool/Hex.app/PlugIns/Keyboard.appex/Keyboard; do
  sdk=$(llvm-otool -l "$binary" | awk '/LC_BUILD_VERSION/ {b=1} b && $1 == "sdk" {print $2; exit}')
  [ "$(printf '%s\n27.1\n' "$sdk" | sort -V | head -1)" = 27.1 ] || {
    echo "$binary is linked against iOS SDK $sdk; below 27.1 the iPhone Duo runs Hex as an old iPhone app (AGENTS.md, scripts/phone)" >&2
    exit 1
  }
done
rsync -a --delete xtool/Hex.app/ mac:Developer/hex-keyboard-phone/Hex.app/
serial=$(python3 -c "
import glob, os, plistlib, subprocess
path = max(glob.glob(os.path.expanduser('~/.config/xtool/data/??????????')), key=os.path.getmtime)
der = plistlib.load(open(path, 'rb'))['certificate']
print(subprocess.run(['openssl', 'x509', '-inform', 'DER', '-noout', '-serial'], input=der, capture_output=True).stdout.decode().split('=')[1].strip())")
ssh mac sh -s "$serial" < scripts/resign
scripts/backup "$phone"
dictating() {
  ssh mac sh -s "$phone" <<'MAC'
xcrun devicectl device info processes --device "$1" --json-output /tmp/hex-processes.json >/dev/null 2>&1 &&
xcrun devicectl device copy from --device "$1" --domain-type appGroupDataContainer --domain-identifier group.com.shahidy.hexkeyboard \
  --source Library/dictation.json --destination /tmp/hex-dictation.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "
import json, sys
running = any(p['executable'].endswith('Hex.app/Hex') for p in json.load(open('/tmp/hex-processes.json'))['result']['runningProcesses'])
status = json.load(open('/tmp/hex-dictation.json'))
sys.exit(0 if running and (status.get('listening') or status.get('writing')) else 1)"
MAC
}
while dictating; do
  echo "waiting for the dictation on the iPhone to be recorded and written down, since an install would cut it off" >&2
  sleep 2
done
ssh mac xcrun devicectl device install app --device "$phone" Developer/hex-keyboard-phone/Hex.app
ssh mac 'cat > Developer/hex-keyboard-phone/unlocked' < scripts/unlocked
ssh mac "pkill -f hex-keyboard-phone/unlocked; nohup /usr/bin/python3 -I Developer/hex-keyboard-phone/unlocked $phone >/dev/null 2>&1 </dev/null &"
touch "$stamp"
echo "build $number (main $commit) is on the iPhone"
