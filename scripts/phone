#!/bin/sh
# Builds iikb on this Linux box with xtool and provisions it for the free team's devices. The team holds one development
# certificate, and it's the Mac's: xtool's identity (~/.config/xtool/data/<team>) holds that certificate without its
# key, so xtool (Bassim's fork) makes the profiles for it and signs ad hoc, and scripts/resign signs on the Mac, whose
# login keychain has the key.
# Never let xtool revoke a certificate to make its own: that breaks what the Mac signs (stdin is closed, so it can't ask).
# Then it backs up the phone's iikb data here (scripts/backup), and won't install without that backup, and installs it
# through the Mac on the iPhone the Mac reaches, by cable or Wi-Fi, once no dictation is being recorded or written down
# there, as the running app's status in the App Group says, checked last thing before the install. An install that left
# iikb a new, empty container, as one after deleting the app does, is written in the backup's `reinstalls`, so
# scripts/backup and scripts/restore take the near-empty files sent in the day after it for that rather than for you.
# Then it starts iikb in the background, now or the moment the iPhone next unlocks (scripts/unlocked), so Parakeet
# compiles for the new build right away rather than at the next dictation. That compile has iikb write about 500 MB
# (App/Voice/AGENTS.md), so main is installed only when something iikb is built from has changed since the commit last
# installed, which the stamp keeps: a commit to docs, tests or scripts alone goes with the next one that changes iikb.
# It builds GitHub's main as just fetched, not this checkout's main, which an agent's uncommitted work can hold back,
# in its own worktree, so agents' branches and uncommitted edits never reach the phone,
# and one run at a time, so agents installing at once queue instead of sharing that worktree. The build number is main's
# commit count, which Settings › About shows as "Version 0.1.0 (<build>)"; when the iPhone already has that build,
# nothing is built or installed, unless --reinstall (which renews the signing).
# Its build doesn't wait for a turn (~/.local/bin/turn): installs go out the moment main is ready, one at a time by
# this script's own lock, and a build that waited for a turn while holding it could wait on runs queued behind it.
# Installs go out at most once every 10 minutes: a run soon after the last install waits out the rest, then installs
# main as it is by then, so builds that finish meanwhile land as one batch and the runs queued behind it find their
# build already on the iPhone. --now skips the wait.
# Before building it runs scripts/gate and then scripts/formats on that commit, and installs nothing that fails either.
# `scripts/phone iPad` does all of it on the iPad the Mac reaches instead, never touching the iPhone: its own stamp, and
# its own backup (~/.local/share/iikb/backup-ipad, as the backup server keeps an iPad's apart; docs/backup.md).
# Usage: scripts/phone [iPad] [--now|--reinstall]
set -e
cd "$(dirname "$0")/.."
kind=iPhone flag=
for arg; do
  case $arg in (iPhone|iPad) kind=$arg ;; (--now|--reinstall) flag=$arg ;; (*) echo "usage: scripts/phone [iPad] [--now|--reinstall]" >&2; exit 2 ;; esac
done
set -- $flag
build=../iikb-build
exec 9>"$build.lock"
flock 9
stamp=$build.installed
backups=${IIKB_BACKUP:-$HOME/.local/share/iikb/backup}
if [ "$kind" != iPhone ]; then
  stamp=$stamp-$(echo "$kind" | tr A-Z a-z)
  backups=$HOME/.local/share/iikb/backup-$(echo "$kind" | tr A-Z a-z)
fi
wait=$(( ${PHONE_EVERY:-600} - $(date +%s) + $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
if [ "$wait" -gt 0 ] && [ "${1:-}" != --now ]; then
  echo "the last install was under 10 minutes ago, so this one installs main as it is in ${wait}s, with whatever lands meanwhile" >&2
  sleep "$wait"
fi
[ -d "$build" ] || git worktree add -q --detach "$build"
git fetch -q origin main
commit=$(git rev-parse --short origin/main)
number=$(git rev-list --count origin/main)
phone=$(ssh mac sh -s "$kind" <<'MAC'
xcrun devicectl list devices --json-output /tmp/iikb-phone.json >/dev/null && /usr/bin/python3 -c "
import json, sys
for d in json.load(open('/tmp/iikb-phone.json'))['result']['devices']:
    h, c = d['hardwareProperties'], d['connectionProperties']
    if h.get('deviceType') == sys.argv[1] and h.get('reality') == 'physical' and c.get('transportType'): print(h['udid']); break" "$1"
MAC
)
[ -n "$phone" ] || { echo "the Mac doesn't reach an $kind" >&2; exit 1; }
installed=$(ssh mac sh -s "$phone" <<'MAC'
xcrun devicectl device info apps --device "$1" --bundle-id com.shahidy.iikb --json-output /tmp/iikb-apps.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "import json; print(next((a.get('bundleVersion', '') for a in json.load(open('/tmp/iikb-apps.json'))['result']['apps']), ''))"
MAC
)
if [ -n "$installed" ] && [ "$installed" -gt "$number" ] && [ "${1:-}" != --reinstall ]; then
  echo "the $kind has build $installed, newer than main's $number ($commit), so nothing is installed" >&2
  exit 1
fi
if [ "$installed" = "$number" ] && [ "${1:-}" != --reinstall ]; then
  echo "build $number (main $commit) is already on the $kind"
  exit 0
fi
read -r stamped from < "$stamp" 2>/dev/null || true
if [ "$installed" = "${stamped:-}" ] && [ "${1:-}" != --reinstall ] && git diff --quiet "$from" "$commit" -- App Keyboard Config/xtool \
  xtool.yml Package.swift Package.resolved Packages/KeyboardModules/Package.swift Packages/KeyboardModules/Sources ':(exclude)**/AGENTS.md' 2>/dev/null; then
  echo "build $installed (main $from) is on the $kind and nothing iikb is built from has changed since, so main $commit waits for a change that needs an install"
  exit 0
fi
git -C "$build" checkout -q -f --detach "$commit"
"$build/scripts/gate" || { echo "build $number (main $commit) fails scripts/gate, so it isn't installed" >&2; exit 1; }
"$build/scripts/formats" || { echo "build $number (main $commit) fails scripts/formats, so it isn't installed" >&2; exit 1; }
for plist in Config/xtool/iikb-Info.plist Config/xtool/Keyboard-Info.plist; do
  python3 -c "import plistlib, sys; p = plistlib.load(open(sys.argv[1], 'rb')); p['CFBundleVersion'] = sys.argv[2]; plistlib.dump(p, open(sys.argv[1], 'wb'))" "$build/$plist" "$number"
done
python3 - "$build" "$commit" <<'PY'
import plistlib, subprocess, sys
build, commit = sys.argv[1], sys.argv[2]
def git(*args):
    return subprocess.run(["git", "-C", build, *args], capture_output=True, text=True, check=True).stdout
entries = []
for line in git("log", "--format=%h%x1f%cs%x1f%(trailers:key=Changelog,valueonly,separator=%x1e)", commit).splitlines():
    sha, day, trailers = line.split("\x1f")
    entries += [(sha, day, change) for change in trailers.split("\x1e") if change]
for line in open(f"{build}/App/Settings/changelog.tsv", encoding="utf-8"):
    sha, change = line.rstrip("\n").split("\t", 1)
    entries.append((sha, git("log", "-1", "--format=%cs", sha).strip(), change))
rows = [{"build": int(git("rev-list", "--count", sha)), "date": day, "change": change} for sha, day, change in entries]
rows = sorted(rows, key=lambda row: row["build"], reverse=True)[:60]
path = f"{build}/Config/xtool/iikb-Info.plist"
info = plistlib.load(open(path, "rb"))
info["IIKBChangelog"] = rows
plistlib.dump(info, open(path, "wb"))
PY
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
backup=$main/Packages/KeyboardModules/Sources/KeyboardStore/Resources/Keys/backup.key
[ -f "$backup" ] || { echo "$backup is missing, so this build wouldn't back up the iPhone's iikb data (docs/backup.md)" >&2; exit 1; }
for key in "$main"/Packages/KeyboardModules/Sources/*/Resources/Keys/*.key; do
  to=$build/${key#"$main"/}
  [ ! -d "${to%/*}" ] || cp "$key" "$to"
done
cd "$build"
TURN=phone xtool dev build -c release --sign < /dev/null
for binary in xtool/iikb.app/iikb xtool/iikb.app/PlugIns/Keyboard.appex/Keyboard; do
  sdk=$(llvm-otool -l "$binary" | awk '/LC_BUILD_VERSION/ {b=1} b && $1 == "sdk" {print $2; exit}')
  [ "$(printf '%s\n27.1\n' "$sdk" | sort -V | head -1)" = 27.1 ] || {
    echo "$binary is linked against iOS SDK $sdk; below 27.1 the iPhone Duo runs iikb as an old iPhone app (AGENTS.md, scripts/phone)" >&2
    exit 1
  }
done
rsync -a --delete xtool/iikb.app/ mac:Developer/iikb-phone/iikb.app/
serial=$(python3 -c "
import glob, os, plistlib, subprocess
path = max(glob.glob(os.path.expanduser('~/.config/xtool/data/??????????')), key=os.path.getmtime)
der = plistlib.load(open(path, 'rb'))['certificate']
print(subprocess.run(['openssl', 'x509', '-inform', 'DER', '-noout', '-serial'], input=der, capture_output=True).stdout.decode().split('=')[1].strip())")
ssh mac sh -s "$serial" < scripts/resign
IIKB_BACKUP=$backups scripts/backup "$phone"
dictating() {
  ssh mac sh -s "$phone" <<'MAC'
xcrun devicectl device info processes --device "$1" --json-output /tmp/iikb-processes.json >/dev/null 2>&1 &&
xcrun devicectl device copy from --device "$1" --domain-type appGroupDataContainer --domain-identifier group.com.shahidy.iikb \
  --source Library/dictation.json --destination /tmp/iikb-dictation.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "
import json, sys
running = any(p['executable'].endswith('iikb.app/iikb') for p in json.load(open('/tmp/iikb-processes.json'))['result']['runningProcesses'])
status = json.load(open('/tmp/iikb-dictation.json'))
sys.exit(0 if running and (status.get('listening') or status.get('writing')) else 1)"
MAC
}
while dictating; do
  echo "waiting for the dictation on the $kind to be recorded and written down, since an install would cut it off" >&2
  sleep 2
done
ssh mac xcrun devicectl device install app --device "$phone" Developer/iikb-phone/iikb.app
fresh=$(ssh mac sh -s "$phone" <<'MAC'
xcrun devicectl device info files --device "$1" --domain-type appDataContainer --domain-identifier com.shahidy.iikb \
  --subdirectory Library --json-output /tmp/iikb-library.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "import json; print(not any(f['relativePath'].startswith('Application Support/') for f in json.load(open('/tmp/iikb-library.json'))['result']['files']))"
MAC
) || true
if [ "$fresh" = True ]; then
  mkdir -p "$backups" && date +%Y-%m-%dT%H%M%S >> "$backups/reinstalls"
  echo "the install started iikb in a new, empty container; scripts/restore $phone puts its data back (docs/backup.md)" >&2
fi
ssh mac 'cat > Developer/iikb-phone/unlocked' < scripts/unlocked
ssh mac "pkill -f 'iikb-phone/unlocked $phone'; nohup /usr/bin/python3 -I Developer/iikb-phone/unlocked $phone >/dev/null 2>&1 </dev/null &"
echo "$number $(git rev-parse "$commit")" > "$stamp"
echo "build $number (main $commit) is on the $kind"
