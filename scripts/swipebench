#!/bin/bash
# Runs on the Mac. Replays recorded swipes through a keyboard on the iPhone Duo and writes what each typed:
# scripts/swipebench system|hex out.tsv [fixture] [first count]. SCREEN picks the Duo's screen (folded-portrait, folded-landscape,
# open-landscape, open-portrait; as scripts/sim names them). scripts/swipescore.py compares two outputs.
set -euo pipefail
cd "$(dirname "$0")/.."
KEYBOARD=$1
OUT=$2
touch "$OUT"
SCREEN=${SCREEN:-folded-portrait}
case $SCREEN in
  folded-portrait) hinge=0 orientation=portrait ;;
  folded-landscape) hinge=0 orientation=landscape-right ;;
  open-landscape) hinge=180 orientation=portrait ;;
  open-portrait) hinge=180 orientation=landscape-right ;;
esac
ID=$(scripts/sim ensure "iPhone Duo" iPhone-Duo)
scripts/sim boot "$ID"
scripts/sim use "$ID" "$KEYBOARD"
[ "$hinge" = 0 ] || scripts/sim unfold "$ID" "$hinge"
scripts/sim hub "$ID" orientation "$orientation"
xcodegen generate -q
xcodebuild build-for-testing -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" -derivedDataPath build/uitest -quiet 2>&1 | grep -E "error:" || true
TEST_RUNNER_HEX_SWIPE_IN="$(realpath "${3:-scripts/swipebench.tsv}")" TEST_RUNNER_HEX_SWIPE_OUT="$(realpath "$OUT")" TEST_RUNNER_HEX_SWIPE_FIRST="${4:-0}" TEST_RUNNER_HEX_SWIPE_COUNT="${5:-}" \
  TEST_RUNNER_HEX_SWIPE_ORIENTATION="$([ "$orientation" = portrait ] && echo portrait || echo landscape)" \
  xcodebuild test-without-building -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
  -derivedDataPath build/uitest -only-testing:HexUITests/SwipeBench 2>&1 | grep -E "error:|failed|Executed" || true
mkdir -p shots/raw/swipebench
cp "$OUT" shots/raw/swipebench/
