#!/bin/bash
# Runs on the Mac. OPEN=1 unfolds the iPhone Duo first. The GIF and clipboard panels through the real keyboard, light and dark, screenshotting
# each step into shots/raw/panels/: scripts/paneltest ["iPhone Duo"] [iPhone-Duo] (RUNTIME picks the iOS; ORIENTATION=landscape)
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone 17}
TYPE=${2:-iPhone-17}
export APP=build/uitest/Build/Products/Debug-iphonesimulator/Hex.app
ID=$(scripts/sim ensure "$NAME" "$TYPE")
slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')
mkdir -p shots/raw/panels
xcodegen generate -q
xcodebuild build-for-testing -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet 2>&1 | grep -E "error" || true
scripts/sim boot "$ID"
scripts/sim use "$ID" hex
[ -n "${OPEN:-}" ] && scripts/sim unfold "$ID"
# Full Access, written where Settings › General › Keyboard › Keyboards › Hex › Allow Full Access writes it, since
# Settings' rows differ between iOS versions. Paste from Other Apps is left for the test to turn on.
xcrun simctl shutdown "$ID"
for client in com.shahidy.hexkeyboard com.shahidy.hexkeyboard.keyboard; do
  sqlite3 ~/Library/Developer/CoreSimulator/Devices/"$ID"/data/Library/TCC/TCC.db "insert or replace into access
    (service, client, client_type, auth_value, auth_reason, auth_version, flags) values ('kTCCServiceKeyboardNetwork', '$client', 0, 2, 4, 1, 0)"
done
scripts/sim boot "$ID"
for appearance in ${APPEARANCES:-light dark}; do
  xcrun simctl ui "$ID" appearance "$appearance"
  TEST_RUNNER_HEX_SHOTS="$PWD/shots/raw/panels/$slug-${ORIENTATION:-portrait}-$appearance" TEST_RUNNER_HEX_ORIENTATION="${ORIENTATION:-portrait}" \
    xcodebuild test-without-building -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
    -derivedDataPath build/uitest -only-testing:HexUITests/ToolPanelTests > build/uitest/panels.log 2>&1 || true
  grep -E "error:|XCTAssert|Test Case .*(passed|failed)|Executed" build/uitest/panels.log || true
done
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
