#!/bin/bash
# Runs on the Mac. Headless simulator helpers for screenshots and keyboard checks. Each scripts/mac slot has its own
# simulators (SIMPREFIX, hexkb<n>), and ensure shuts down the slot's others, so a slot boots one at a time.
set -euo pipefail
cd "$(dirname "$0")/.."

APP=${APP:-build/Build/Products/Debug-iphonesimulator/Hex.app}
BUNDLE=com.shahidy.hexkeyboard
# The iPhone Duo's screens, as Bassim names them: name, hinge angle, Device Hub orientation, display. Slightly folded is
# the small fold his reports are about.
DUO_SCREENS="folded-portrait 0 portrait 1
folded-landscape 0 landscape-right 1
open-landscape 180 portrait 3
open-portrait 180 landscape-right 3
open-landscape-slightly-folded 160 portrait 3
open-portrait-slightly-folded 160 landscape-right 3"
PREFIX=${SIMPREFIX:-hexkb}

# A simulator's id by name, in RUNTIME if set.
udid() {
  xcrun simctl list devices -j | /usr/bin/python3 -c "
import json, sys
name, runtime = sys.argv[1], sys.argv[2]
for r, ds in json.load(sys.stdin)['devices'].items():
    for d in ds:
        if d['name'] == name and d['isAvailable'] and runtime in ('', r): print(d['udid']); sys.exit()" "$1" "${RUNTIME:-}"
}

# The slot's one simulator of a device type (named for the type, whatever name the caller gives), made on RUNTIME or
# else the newest iOS that has the type (iOS 27.1 for the iPhone Duo, the only one that has it), with the slot's other
# simulators shut down.
ensure() {
  local name="$PREFIX ${2//-/ }" type="com.apple.CoreSimulator.SimDeviceType.$2" id runtime
  id=$(udid "$name")
  if [ -z "$id" ]; then
    runtime=${RUNTIME:-$(xcrun simctl list runtimes -j | /usr/bin/python3 -c "
import json, sys
print([r['identifier'] for r in json.load(sys.stdin)['runtimes'] if r['platform'] == 'iOS' and r['isAvailable']
       and any(d['identifier'] == sys.argv[1] for d in r['supportedDeviceTypes'])][-1])" "$type")}
    id=$(xcrun simctl create "$name" "$type" "$runtime")
  fi
  for other in $(xcrun simctl list devices booted | sed -n "s/^ *$PREFIX .*(\([0-9A-F-]\{36\}\)) (Booted).*/\1/p"); do
    [ "$other" = "$id" ] || xcrun simctl shutdown "$other"
  done
  echo "$id"
}

boot() {
  xcrun simctl bootstatus "$1" -b >/dev/null
  xcrun simctl spawn "$1" defaults write com.apple.keyboard.preferences DidShowContinuousPathIntroduction -bool true
  xcrun simctl install "$1" "$APP"
}

# Turns on Full Access (with paste, Paste from Other Apps too), which iOS keeps in TCC's database, written where Settings
# writes it; a simulator without them restarts to take them.
allow() {
  local db=~/Library/Developer/CoreSimulator/Devices/$1/data/Library/TCC/TCC.db
  local rows="('kTCCServiceKeyboardNetwork', '$BUNDLE'), ('kTCCServiceKeyboardNetwork', '$BUNDLE.keyboard')"
  [ "${2:-}" = paste ] && rows="$rows, ('kTCCServicePasteboard', '$BUNDLE')"
  xcrun simctl bootstatus "$1" -b >/dev/null
  [ "$(sqlite3 "$db" "select count(*) = $(grep -o '(' <<<"$rows" | wc -l) from access where auth_value = 2 and (service, client) in (values $rows)")" = 1 ] && return
  xcrun simctl shutdown "$1"
  sqlite3 "$db" "insert or replace into access (service, client, client_type, auth_value, auth_reason, auth_version, flags)
    select column1, column2, 0, 2, 4, 1, 0 from (values $rows)"
  boot "$1"
}

use() {
  local id=$1 keyboards
  case $2 in
    hex) keyboards=("com.shahidy.hexkeyboard.keyboard" "en_US@sw=QWERTY;hw=Automatic") ;;
    system) keyboards=("en_US@sw=QWERTY;hw=Automatic") ;;
  esac
  local current expanded
  current=$(xcrun simctl spawn "$id" defaults read .GlobalPreferences AppleKeyboards 2>/dev/null | sed '1d;$d' | tr -d ' ",\n' || true)
  expanded=$(xcrun simctl spawn "$id" defaults read .GlobalPreferences AppleKeyboardsExpanded 2>/dev/null || true)
  [ "$current" = "$(printf %s "${keyboards[@]}")" ] && [ "$expanded" = 1 ] && return
  xcrun simctl spawn "$id" defaults write .GlobalPreferences AppleKeyboards -array "${keyboards[@]}"
  xcrun simctl spawn "$id" defaults write .GlobalPreferences AppleKeyboardsExpanded -int 1
  xcrun simctl shutdown "$id"
  boot "$id"
}

shoot() {
  local id=$1 keyboard=$2 appearance=$3 out=$4; shift 4
  xcrun simctl ui "$id" appearance "$appearance"
  xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
  use "$id" "$keyboard"
  local attempt orientation=(-HexOrientation portrait)
  [[ " $* " == *HexOrientation* ]] && orientation=()
  for attempt in 1 2 3 4 5; do
    xcrun simctl launch "$id" "$BUNDLE" -HexFocus YES ${orientation[@]+"${orientation[@]}"} "$@" >/dev/null 2>&1 && break
    [ "$attempt" = 3 ] && xcrun simctl install "$id" "$APP"
    sleep 2
  done
  sleep "${SETTLE:-3}"
  mkdir -p "$(dirname "$out")"
  xcrun simctl io "$id" screenshot ${DISPLAY_ID:+--display="$DISPLAY_ID"} "$out" >/dev/null 2>&1
}

DEVICES=("iPhone 17:iPhone-17" "iPhone 17 Pro Max:iPhone-17-Pro-Max" "iPhone 16e:iPhone-16e" "iPhone Air:iPhone-Air"
  "iPad Pro 11:iPad-Pro-11-inch-M5-12GB" "iPad Pro 13:iPad-Pro-13-inch-M5-12GB" "iPad A16:iPad-A16" "iPad mini:iPad-mini-A17-Pro"
  "iPhone Duo:iPhone-Duo")

all() {
  local tag=$1; shift
  for spec in "${DEVICES[@]:0:8}"; do
    local name=${spec%%:*} id slug
    [ -n "${ONLY:-}" ] && [[ "$name" != *$ONLY* ]] && continue
    slug=$(echo "$name" | tr 'A-Z ' 'a-z-')
    id=$(ensure "$name" "${spec##*:}")
    boot "$id"
    for keyboard in ${KEYBOARDS:-system hex}; do
      for appearance in light dark; do
        shoot "$id" "$keyboard" "$appearance" "shots/raw/$slug-$tag-$keyboard-$appearance.png" "$@"
      done
    done
    [ -n "${KEEP:-}" ] || xcrun simctl shutdown "$id"
  done
}

variants() {
  local name=$1 tag=$2 id slug spec
  for spec in "${DEVICES[@]}"; do [ "${spec%%:*}" = "$name" ] && id=$(ensure "$name" "${spec##*:}"); done
  slug=$(echo "$name" | tr 'A-Z ' 'a-z-')
  boot "$id"
  for keyboard in ${KEYBOARDS:-system hex}; do
    while read -r variant args; do
      shoot "$id" "$keyboard" "${APPEARANCE:-light}" "shots/raw/$slug-$tag-$variant-$keyboard.png" $args
    done <<VARIANTS
return-go -HexReturnKey 1
return-search -HexReturnKey 6
return-send -HexReturnKey 7
return-done -HexReturnKey 9
return-next -HexReturnKey 4
type-email -HexKeyboardType 7
type-url -HexKeyboardType 3
type-numbers -HexKeyboardType 2
type-websearch -HexKeyboardType 10
landscape -HexOrientation landscape
VARIANTS
  done
  [ -n "${KEEP:-}" ] || xcrun simctl shutdown "$id"
}

# Sends Device Hub's events to a booted iPhone Duo (scripts/devicehub.c): hub ID hinge 180, hub ID orientation portrait.
hub() {
  local helper=build/devicehub
  [ "$helper" -nt scripts/devicehub.c ] || { xcrun -sdk iphonesimulator clang -arch arm64 -mios-simulator-version-min=27.0 -O2 \
    -o "$helper" scripts/devicehub.c -framework IOKit -framework CoreFoundation && codesign -f -s - "$helper" 2>/dev/null; }
  xcrun simctl spawn "$1" "$PWD/$helper" "${@:2}"
}

# Opens a booted iPhone Duo (or folds it, with 0); a reboot folds it again.
unfold() {
  hub "$1" hinge "${2:-180}"
  sleep 3
}

# Screenshots each keyboard on the iPhone Duo's four screens (folded and open, portrait and landscape, as Bassim names
# them) and the open ones slightly folded, in the iOS 27.1 simulator, the only one with the Duo:
# shots/raw/duo/<tag>-<screen>-<keyboard>-<appearance>.png. The open screen comes from unfolding the simulator
# (scripts/devicehub.c); a reboot folds it again. The open screen's own upright is landscape, 951 wide, so Device Hub's
# portrait shows it in landscape. SCREENS (folded-portrait open-landscape …) picks some. LISTENING=1 shows the bar while you talk, saved or waiting with dictations saved (scripts/voiceapp.py); DUO names the simulator.
duo() {
  local tag=$1 id app=; shift
  id=$(ensure "${DUO:-iPhone Duo}" iPhone-Duo)
  for keyboard in ${KEYBOARDS:-system hex}; do
    xcrun simctl shutdown "$id" 2>/dev/null || true
    boot "$id"
    [ -z "${LISTENING:-}" ] || allow "$id"
    if [ -n "${LISTENING:-}" ] && [ "$keyboard" = hex ]; then
      /usr/bin/python3 scripts/voiceapp.py "$id" "$(xcrun simctl get_app_container "$id" "$BUNDLE" group.com.shahidy.hexkeyboard)" "$([ "$LISTENING" = 1 ] && echo listening || echo "$LISTENING")" &
      app=$!
    fi
    while read -r screen hinge orientation display; do
      [ -n "${SCREENS:-}" ] && [[ " $SCREENS " != *" $screen "* ]] && continue
      case $screen in open-*) unfold "$id" "$hinge" ;; esac
      hub "$id" orientation "$orientation"
      for appearance in ${APPEARANCES:-light dark}; do
        DISPLAY_ID=$display shoot "$id" "$keyboard" "$appearance" "shots/raw/duo/$tag-$screen-$keyboard-$appearance.png" \
          -HexOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" "$@"
      done
    done <<<"$DUO_SCREENS"
    [ -z "$app" ] || { kill "$app"; wait "$app" 2>/dev/null || true; app=; }
  done
  [ -n "${KEEP:-}" ] || xcrun simctl shutdown "$id"
}

# Screenshots the keyboard in every theme on the iPhone Duo, folded and open, light and dark:
# shots/raw/themes/<tag>-<theme>-<screen>-<appearance>.png. THEMES and SCREENS (folded-portrait folded-landscape
# open-landscape open-portrait) pick some; extra arguments go to the app (-HexReturnKey 1).
themes() {
  local tag=$1 id; shift
  id=$(ensure "iPhone Duo" iPhone-Duo)
  xcrun simctl shutdown "$id" 2>/dev/null || true
  boot "$id"
  while read -r screen hinge orientation display; do
    [ -n "${SCREENS:-}" ] && [[ " $SCREENS " != *" $screen "* ]] && continue
    case $screen in open-*) unfold "$id" "$hinge" ;; esac
    hub "$id" orientation "$orientation"
    for theme in ${THEMES:-standard clear physical physical-dark physical-light mechanical mechanical-dark mechanical-light classic}; do
      local name=${theme%%-*} look=automatic
      [ "$name" != "$theme" ] && look=${theme#*-}
      for appearance in ${APPEARANCES:-dark light}; do
        DISPLAY_ID=$display shoot "$id" hex "$appearance" "shots/raw/themes/$tag-$theme-$screen-$appearance.png" \
          -HexOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" -HexTheme "$name" -HexThemeAppearance "$look" "$@"
      done
    done
  done <<<"$DUO_SCREENS"
  [ -n "${KEEP:-}" ] || xcrun simctl shutdown "$id"
}

# Screenshots each of the app's screens on the iPhone Duo's four screens, as duo does for the keyboard:
# shots/raw/duo/app/<tag>-<screen>-<page>-<appearance>.png. TOUCHES (a touch model, as the keyboard shares it),
# TYPING (JSON lines of hours, as the keyboard shares them) and TRANSCRIPTS (JSON lines, as the app keeps them) fill
# Stats and Transcripts, MAC (a Keystroke typing-stats.json) Stats' Mac as the copy last read, and CLIPBOARD (a
# history.json, as ClipboardStore keeps it) Clipboard; PAGES picks the pages; ARGS adds launch arguments to each
# (-HexScrollToEnd YES shows each page's end); SIM names the simulator.
duoapp() {
  local tag=$1 id data group; shift
  id=$(ensure "${SIM:-iPhone Duo}" iPhone-Duo)
  boot "$id"
  allow "$id" paste
  use "$id" hex
  unfold "$id" 0
  group=$(xcrun simctl get_app_container "$id" "$BUNDLE" group.com.shahidy.hexkeyboard)
  data=$(xcrun simctl get_app_container "$id" "$BUNDLE" data)
  [ -n "${TOUCHES:-}" ] && mkdir -p "$group/Library" && cp "$TOUCHES" "$group/Library/touches.json"
  [ -n "${TYPING:-}" ] && mkdir -p "$group/Library" && cp "$TYPING" "$group/Library/typing.jsonl"
  [ -n "${MAC:-}" ] && mkdir -p "$data/Library/Caches" && cp "$MAC" "$data/Library/Caches/mac-stats.json"
  [ -n "${TRANSCRIPTS:-}" ] && mkdir -p "$data/Library/Application Support" && cp "$TRANSCRIPTS" "$data/Library/Application Support/transcripts.jsonl"
  [ -n "${CLIPBOARD:-}" ] && mkdir -p "$group/Library/clipboard" && cp "$CLIPBOARD" "$group/Library/clipboard/history.json"
  while read -r screen hinge orientation display; do
    case $screen in open-*) unfold "$id" "$hinge" ;; esac
    hub "$id" orientation "$orientation"
    for appearance in ${APPEARANCES:-dark light}; do
      xcrun simctl ui "$id" appearance "$appearance"
      while read -r page args; do
        [ -n "${PAGES:-}" ] && [[ " $PAGES " != *" $page "* ]] && continue
        xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
        hub "$id" orientation "$orientation"
        xcrun simctl launch "$id" "$BUNDLE" -HexOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" $args ${ARGS:-} >/dev/null 2>&1 || true
        sleep "${SETTLE:-4}"
        mkdir -p shots/raw/duo/app
        xcrun simctl io "$id" screenshot --display="$display" "shots/raw/duo/app/$tag-$screen-$page-$appearance.png" >/dev/null 2>&1
      done <<PAGES
home -HexTab home
typing -HexFocus YES
settings -HexSettings YES
keyboard -HexSettings theme
typing-settings -HexSettings typing
layout -HexSettings layout
feedback -HexSettings feedback
voice -HexSettings model
writing -HexSettings writing
dictionary -HexSettings dictionary
microphone -HexSettings microphone
mic -HexSettings mic
transcripts -HexTab transcripts
clipboard -HexTab clipboard
stats -HexStats typing
stats-dictation -HexStats dictation
stats-mac -HexStats typing -HexStatsDevice mac
stats-mac-dictation -HexStats dictation -HexStatsDevice mac
taps -HexTaps YES
sources -HexSettings sources
access -HexSettings access
PAGES
    done
  done <<<"$DUO_SCREENS"
  [ -n "${KEEP:-}" ] || xcrun simctl shutdown "$id"
}

# Screenshots the app's Stats › Taps screen showing a touch model (JSON, as the keyboard shares it), light and dark:
# Heat, Aim and Accuracy, each alone and with KEY selected (Heat's scrolled to the key's close-up), and the
# thumbs and most-missed sections at the bottom.
taps() {
  local name=$1 type=$2 touches=$3 tag=$4 id slug group attempt
  id=$(ensure "$name" "$type")
  slug=$(echo "$name" | tr 'A-Z ' 'a-z-')
  boot "$id"
  group=$(xcrun simctl get_app_container "$id" "$BUNDLE" group.com.shahidy.hexkeyboard)
  mkdir -p "$group/Library" && cp "$touches" "$group/Library/touches.json"
  for appearance in light dark; do
    xcrun simctl ui "$id" appearance "$appearance"
    while read -r variant args; do
      xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
      for attempt in 1 2 3; do
        xcrun simctl launch "$id" "$BUNDLE" -HexTaps YES $args >/dev/null 2>&1 && break
        sleep 2
      done
      sleep "${SETTLE:-3}"
      xcrun simctl io "$id" screenshot "shots/raw/$slug-$tag-taps-$variant-$appearance.png" >/dev/null 2>&1
    done <<VARIANTS
heat
heat-key -HexTapsKey ${KEY:-p} -HexTapsScroll detail
aim -HexTapsMode aim
aim-key -HexTapsMode aim -HexTapsKey ${KEY:-p}
accuracy -HexTapsMode accuracy
accuracy-key -HexTapsMode accuracy -HexTapsKey ${KEY:-p}
thumbs -HexTapsScroll bottom
VARIANTS
  done
  [ -n "${KEEP:-}" ] || xcrun simctl shutdown "$id"
}

"$@"
