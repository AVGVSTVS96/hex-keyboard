#!/bin/sh
# Times a Parakeet loading and writing on the iPhone the Mac reaches, in the installed iikb (scripts/phone):
# scripts/voiceprobe <ultra|v3|unified|unified-fp16|clean> <clip.wav> [ane|cpu|gpu]. iikb plays silence while it runs, so
# a locked screen or another app in front doesn't suspend it. Prints Documents/probe.log once the run is done. clean
# deletes what a Unified probe downloaded.
set -e
[ -n "$2" ] || { echo "usage: scripts/voiceprobe <ultra|v3|unified|unified-fp16|clean> <clip.wav> [ane|cpu|gpu]" >&2; exit 1; }
scp -q "$2" mac:/tmp/iikb-probe.wav
ssh mac sh -s "$1" "${3:-ane}" <<'MAC'
set -e
phone=$(xcrun devicectl list devices --json-output /tmp/iikb-phone.json >/dev/null && /usr/bin/python3 -c "
import json
for d in json.load(open('/tmp/iikb-phone.json'))['result']['devices']:
    h, c = d['hardwareProperties'], d['connectionProperties']
    if h.get('deviceType') == 'iPhone' and h.get('reality') == 'physical' and c.get('transportType'): print(h['udid']); break")
[ -n "$phone" ] || { echo "the Mac doesn't reach an iPhone" >&2; exit 1; }
container="--device $phone --domain-type appDataContainer --domain-identifier com.shahidy.iikb"
xcrun devicectl device copy to $container --source /tmp/iikb-probe.wav --destination Documents/probe.wav >/dev/null
xcrun devicectl device copy to $container --source /dev/null --destination Documents/probe.log >/dev/null
xcrun devicectl device process launch --terminate-existing --device "$phone" com.shahidy.iikb -- -iikbVoiceProbe "$1" -iikbVoiceProbeUnits "$2" >/dev/null
until xcrun devicectl device copy from $container --source Documents/probe.log --destination /tmp/iikb-probe.log >/dev/null 2>&1 && grep -q "done ·" /tmp/iikb-probe.log; do sleep 15; done
cat /tmp/iikb-probe.log
MAC
