#!/bin/sh
# Runs on the Mac. Types the phrase corpus with simulated tap noise and prints the autocorrect baseline.
set -e
cd "$(dirname "$0")/../Packages/HexKeyboard"
ID=$(../../scripts/sim ensure "iPhone 17" iPhone-17)
xcodebuild test -scheme HexKeyboard-Package -destination "id=$ID" -derivedDataPath ../../build/tests \
  -only-testing:KeyboardUITests/Evaluation 2>&1 | grep -E "error:|EVAL|✘" || true
