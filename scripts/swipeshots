#!/bin/bash
# Runs on the Mac. A swipe's trail and the bar after it, through iikb on the iPhone Duo folded and open, light and dark:
# shots/raw/swipe/<tag>-<screen>-<appearance>-trail.png and -bar.png. The trail is taken as the finger lifts, so it is
# partly faded.
set -euo pipefail
cd "$(dirname "$0")/.."
tag=${1:?tag}
id=$(scripts/sim ensure "iPhone Duo" iPhone-Duo)
xcrun simctl shutdown "$id" 2>/dev/null || true
scripts/sim boot "$id"
scripts/sim use "$id" iikb
mkdir -p shots/raw/swipe
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$id" -derivedDataPath build/uitest -quiet
while read -r screen hinge orientation open; do
  [ "$hinge" = 0 ] || scripts/sim unfold "$id" "$hinge"
  scripts/sim hub "$id" orientation "$orientation"
  for appearance in light dark; do
    xcrun simctl ui "$id" appearance "$appearance"
    TEST_RUNNER_IIKB_SHOTS="$PWD/shots/raw/swipe/$tag-$screen-$appearance" TEST_RUNNER_IIKB_SWIPE_ORIENTATION=portrait TEST_RUNNER_IIKB_SWIPE_OPEN=$open \
      xcodebuild test-without-building -project iikb.xcodeproj -scheme iikb -destination "id=$id" \
      -derivedDataPath build/uitest -only-testing:AppUITests/SwipeShots 2>&1 | grep -E "error:|failed|Executed"
  done
done <<'SCREENS'
folded 0 portrait
open 180 portrait 1
SCREENS
xcrun simctl shutdown "$id"
