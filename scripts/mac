#!/bin/sh
# Syncs the tree to the Mac, runs a command there with Xcode 27.1 (the SDK the phone build uses, which gives the iPhone
# Duo its vertical bar), and copies screenshots back. Runs from every checkout take turns on the Mac, one at a time.
set -e
cd "$(dirname "$0")/.."
dir=$(scripts/sync)
printf '%s\n' "$*" | ssh mac "cd ~/$dir && export DEVELOPER_DIR=\${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} &&
  { lockf -t 0 /tmp/hexkb.lock true || echo 'waiting for the Mac: another Hex keyboard run has it' >&2; } &&
  lockf /tmp/hexkb.lock zsh -s"
mkdir -p shots/raw
rsync -a "mac:$dir/shots/raw/" shots/raw/ 2>/dev/null || true
