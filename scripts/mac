#!/bin/bash
# Runs a command on the Mac with Xcode 27.1 (the SDK the phone build uses, which gives the iPhone Duo its vertical bar)
# in the first free of the Mac's slots, so up to three runs go at once and the rest wait for one to free up. The Mac
# runs at most three simulators, so one something else has booted (another project's) takes a slot away. Each slot
# has its own folder (~/Developer/hex-keyboard-slot<n>, where this tree is synced) and its own simulators (hexkb<n> …),
# shut down when the run ends. Screenshots the command takes are copied back to shots/raw/.
set -euo pipefail
cd "$(dirname "$0")/.."
slot='
import fcntl, json, re, subprocess, sys, threading
booted = json.loads(subprocess.run(["xcrun", "simctl", "list", "devices", "booted", "-j"], capture_output=True).stdout or "{}")
others = sum(not re.match(r"hexkb[123] ", d["name"]) for ds in booted.get("devices", {}).values() for d in ds)
slots = [open(f"/tmp/hexkb-slot{n}.lock", "a") for n in range(1, max(1, 3 - others) + 1)]
def take(f, block):
    try:
        fcntl.flock(f, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
        return True
    except BlockingIOError:
        return False
taken = next((n for n, f in enumerate(slots, 1) if take(f, False)), None)
if taken is None:
    print("waiting for the Mac: its three simulators are taken", file=sys.stderr, flush=True)
    won, guard, first = threading.Event(), threading.Lock(), []
    def wait(n, f):
        take(f, True)
        with guard:
            if first:
                return f.close()
            first.append(n)
        won.set()
    for n, f in enumerate(slots, 1):
        threading.Thread(target=wait, args=(n, f), daemon=True).start()
    won.wait()
    taken = first[0]
print(taken, flush=True)
sys.stdin.read()
'
coproc held { ssh mac "$(printf '%q ' /usr/bin/python3 -u -c "$slot")"; }
read -r n <&"${held[0]}"
dir=Developer/hex-keyboard-slot$n
shutdown() {
  ssh mac sh -s "hexkb$n" <<'MAC' || true
xcrun simctl list devices booted | sed -n "s/^ *$1 .*(\([0-9A-F-]\{36\}\)) (Booted).*/\1/p" | xargs -n 1 xcrun simctl shutdown
MAC
}
trap shutdown EXIT
ssh mac "mkdir -p ~/$dir && rm -rf ~/$dir/shots/raw" </dev/null
scripts/sync "$dir" >/dev/null
status=0
printf '%s\n' "$*" | ssh mac "cd ~/$dir && export SIMPREFIX=hexkb$n DEVELOPER_DIR=\${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} && zsh -s" || status=$?
mkdir -p shots/raw
rsync -a "mac:$dir/shots/raw/" shots/raw/ 2>/dev/null </dev/null || true
exit "$status"
