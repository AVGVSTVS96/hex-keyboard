#!/bin/sh
# Syncs the tree to the Mac, runs a command there with Xcode 27.1 (the SDK the phone build uses, which gives the iPhone
# Duo its vertical bar), and copies screenshots back.
set -e
cd "$(dirname "$0")/.."
dir=$(scripts/sync)
ssh mac "cd ~/$dir && export DEVELOPER_DIR=\${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} && $*"
mkdir -p shots/raw
rsync -a "mac:$dir/shots/raw/" shots/raw/ 2>/dev/null || true
