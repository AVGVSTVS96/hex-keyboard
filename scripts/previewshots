#!/bin/bash
# Runs on the Mac. The link preview's frames: the keyboard in landscape, dark, typing, swiping, picking an emoji and a
# GIF and dictating (UITests/PreviewShots), with scripts/voiceapp.py standing in for the app, into shots/raw/preview/.
# Reduce Transparency is on so the keyboard is drawn opaque, not over whatever the app shows behind it. brand/og/render.sh
# makes the video from them.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
export APP=build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
ID=$(scripts/sim ensure "$NAME" "$TYPE")
rm -rf shots/raw/preview && mkdir -p shots/raw/preview
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet
scripts/sim boot "$ID"
xcrun simctl spawn "$ID" defaults write com.apple.Accessibility EnhancedBackgroundContrastEnabled -bool true
scripts/sim use "$ID" iikb
scripts/sim allow "$ID"
xcrun simctl ui "$ID" appearance dark
group=$(xcrun simctl get_app_container "$ID" com.shahidy.iikb group.com.shahidy.iikb)
said=$(mktemp)
echo "and it writes down what you say" >"$said"
/usr/bin/python3 scripts/voiceapp.py "$ID" "$group" edited "$(uuidgen)" "$said" &
app=$!
TEST_RUNNER_IIKB_SHOTS="$PWD/shots/raw/preview/f" \
  xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -only-testing:AppUITests/PreviewShots > build/uitest/preview.log 2>&1 || failed=1
grep -E "error:|XCTAssert|Test Case .*(passed|failed)|Executed" build/uitest/preview.log || true
kill "$app" 2>/dev/null || true
rm -f "$said"
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
exit "${failed:-0}"
