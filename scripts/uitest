#!/bin/bash
# Runs on the Mac. Types through the real keyboard extension with XCUITest.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
ID=$(scripts/sim ensure "$NAME" "$TYPE")
scripts/sim boot "$ID"
scripts/sim use "$ID" iikb
xcodegen generate -q
rm -rf build/uitest/result.xcresult
xcodebuild test -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest \
  -resultBundlePath build/uitest/result.xcresult -skip-testing:KeyboardUITests/Evaluation "${@:3}" 2>&1 \
  | grep -E "error:|Test Case .*(passed|failed)|XCTAssert|Executed"
