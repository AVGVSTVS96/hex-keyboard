#!/bin/bash
# Sets up the Mac `ssh mac` reaches, both ways: it shares what Keystroke counts there with iikb (mac/share,
# docs/computers.md), and Keystroke gets the backup server's key, to show the iPhone's counts the server makes
# (docs/stats.md). Prints the link to add the Mac in iikb.
# Usage: scripts/keystroke [path to Keystroke's typing-stats.json on the Mac]
set -euo pipefail
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
key=$root/Packages/KeyboardModules/Sources/KeyboardStore/Resources/Keys/backup.key
[ -f "$key" ] || { echo "$key is missing: Keystroke reads the iPhone's counts with the backup server's address and token (docs/backup.md)" >&2; exit 1; }
ssh mac 'umask 077 && mkdir -p ~/.config/iikb && cat > ~/.config/iikb/backup.key' <"$key"
ssh mac sh -s -- "$@" <"$(dirname "$0")/../mac/share"
