#!/bin/bash
# Runs on the Mac. Holds the emoji key on the iPhone Duo's folded and open screens and screenshots the layout menu it opens:
# shots/raw/layoutmenu/<folded|open>.png. scripts/layoutmenu
set -euo pipefail
cd "$(dirname "$0")/.."
ID=$(scripts/sim ensure "iPhone Duo" iPhone-Duo)
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest -quiet
mkdir -p shots/raw/layoutmenu
scripts/sim boot "$ID"
scripts/sim unfold "$ID" 0
scripts/sim use "$ID" iikb
for screen in "folded 0 portrait 1" "open 180 portrait 3"; do
  read -r name hinge orientation display <<<"$screen"
  [ "$hinge" = 0 ] || scripts/sim unfold "$ID" "$hinge"
  scripts/sim hub "$ID" orientation "$orientation"
  out=$PWD/shots/raw/layoutmenu/$name
  rm -f "$out.holding"
  TEST_RUNNER_IIKB_SHOTS="$out" xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb \
    -destination "id=$ID" -derivedDataPath build/uitest -only-testing:AppUITests/OneHandedTests/testHoldingEmojiOpensTheLayoutMenu \
    > build/uitest/layoutmenu-$name.log 2>&1 &
  test=$!
  until [ -e "$out.holding" ] || ! kill -0 "$test" 2>/dev/null; do sleep 1; done
  sleep 4
  xcrun simctl io "$ID" screenshot --display="$display" "$out.png" >/dev/null 2>&1 || true
  wait "$test" || true
  grep -E "error:|Executed|Test Case .*(passed|failed)" build/uitest/layoutmenu-$name.log || true
done
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
