#!/bin/bash
# Copies iikb's data off the iPhone the Mac reaches into ~/.local/share/iikb/backup here: the app's, the
# keyboard's and the App Group's files, all but Parakeet's models. Nothing is deleted there, and a file a backup
# replaces is kept under versions/<time>, so one wiped on the phone can be put back. scripts/phone runs it before
# every install. In the day after an install left iikb a new, empty container (`reinstalls`, written by scripts/phone), a
# file the iPhone holds at under half the size of the backup's (over 4 KB) is kept under smaller/<time> rather than over
# the backup's, which stays for scripts/restore to put back; --smaller takes such files anyway. Any other shrink was you
# (Reset Learned Words, a deleted transcript) and is backed up as it is.
# IIKB_APP names the app to back up, com.shahidy.iikb unless set.
# Usage: scripts/backup <iPhone UDID> [--smaller]
set -euo pipefail
umask 077
phone=${1:?usage: scripts/backup <iPhone UDID> [--smaller]}
smaller=${2:-}
id=${IIKB_APP:-com.shahidy.iikb}
backup=${IIKB_BACKUP:-$HOME/.local/share/iikb/backup}
mkdir -p "$backup/mirror/app/recordings"
have=$(cd "$backup/mirror/app/recordings" && ls | paste -sd, -)
read -r -d '' mac <<'MAC' || true
set -eu
phone=$1 have=$2 id=$3 out=$(mktemp -d /tmp/iikb-backup.XXXX)
copy() { xcrun devicectl device copy from --device "$phone" --domain-type "$1" --domain-identifier "$2" --source "$3" --destination "$out/$4" >/dev/null; }
list() {
  xcrun devicectl device info files --device "$phone" --domain-type appDataContainer --domain-identifier "$id" \
    --subdirectory "$1" --json-output "$out/list.json" >/dev/null
  /usr/bin/python3 -c "import json, sys; print('\n'.join(f['relativePath'] for f in json.load(open(sys.argv[1]))['result']['files'] if '/' not in f['relativePath']))" "$out/list.json"
}
mkdir -p "$out/app/recordings" "$out/keyboard" "$out/group"
for name in $(list "Library/Application Support"); do
  case $name in (FluidAudio|recordings) ;; (*) copy appDataContainer "$id" "Library/Application Support/$name" "app/$name" ;; esac
done
copy appDataContainer "$id" Library/Preferences app/Preferences
if [ -z "$have" ]; then
  rmdir "$out/app/recordings"
  copy appDataContainer "$id" "Library/Application Support/recordings" app/recordings
else
  for name in $(list "Library/Application Support/recordings"); do
    case ",$have," in (*",$name,"*) ;; (*) copy appDataContainer "$id" "Library/Application Support/recordings/$name" "app/recordings/$name" ;; esac
  done
fi
copy appDataContainer "$id.keyboard" "Library/Application Support" keyboard/support
copy appDataContainer "$id.keyboard" Library/Preferences keyboard/Preferences
copy appGroupDataContainer "group.$id" Library group/Library
rm "$out/list.json"
echo "$out"
MAC
staged=$(ssh mac sh -s "$phone" "$have" "$id" <<<"$mac")
time=$(date +%Y-%m-%dT%H%M%S)
incoming=$(mktemp -d "$backup/incoming.XXXX")
trap 'rm -rf "$incoming"' EXIT
rsync -a "mac:$staged/" "$incoming/"
ssh mac rm -rf "$staged"
[ "$smaller" = --smaller ] || python3 - "$backup" "$incoming" "$time" "$phone" <<'PY'
import datetime, os, sys
backup, incoming, time, phone = sys.argv[1:]
form = '%Y-%m-%dT%H%M%S'
try:
    last = open(os.path.join(backup, 'reinstalls')).read().split()[-1]
except (OSError, IndexError):
    sys.exit()
if datetime.datetime.strptime(time, form) - datetime.datetime.strptime(last, form) >= datetime.timedelta(days=1):
    sys.exit()
held = []
for folder, _, found in os.walk(incoming):
    for name in found:
        path = os.path.join(folder, name)
        name = os.path.relpath(path, incoming)
        kept = os.path.join(backup, 'mirror', name)
        if os.path.exists(kept) and 2 * os.path.getsize(path) < os.path.getsize(kept) > 4096:
            aside = os.path.join(backup, 'smaller', time, name)
            os.makedirs(os.path.dirname(aside), exist_ok=True)
            os.rename(path, aside)
            held.append(f"  {name}: {os.path.getsize(aside):,} bytes on the iPhone, {os.path.getsize(kept):,} in the backup")
if held:
    print("\n".join(["These are much smaller on the iPhone than in the backup, as after a reinstall wiped them, so the "
                     f"backup keeps its own and the iPhone's went to {backup}/smaller/{time}:", *held,
                     f"scripts/restore {phone} puts the backup's back; scripts/backup {phone} --smaller takes the iPhone's."]),
          file=sys.stderr)
PY
rsync -a --checksum --backup --backup-dir="$backup/versions/$time" "$incoming/" "$backup/mirror/"
echo "iikb's data is backed up in $backup"
