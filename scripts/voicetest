#!/bin/bash
# Runs on the Mac. The bar's mic through the real keyboard, with scripts/voiceapp.py standing in for the app, light and
# dark: scripts/voicetest ["iPhone Duo"] [iPhone-Duo]
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
export APP=build/uitest/Build/Products/Debug-iphonesimulator/Hex.app
ID=$(scripts/sim ensure "$NAME" "$TYPE")
slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')
mkdir -p shots/raw/voice
xcodegen generate -q
xcodebuild build-for-testing -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet
scripts/sim boot "$ID"
scripts/sim use "$ID" hex
scripts/sim allow "$ID"
group=$(xcrun simctl get_app_container "$ID" com.shahidy.hexkeyboard group.com.shahidy.hexkeyboard)
for appearance in light dark; do
  xcrun simctl ui "$ID" appearance "$appearance"
  /usr/bin/python3 scripts/voiceapp.py "$ID" "$group" &
  app=$!
  TEST_RUNNER_HEX_SHOTS="$PWD/shots/raw/voice/$slug-$appearance" \
    xcodebuild test-without-building -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
    -derivedDataPath build/uitest -only-testing:HexUITests/VoiceTests > build/uitest/voice.log 2>&1 || failed=1
  grep -E "error:|XCTAssert|Test Case .*(passed|failed)|Executed" build/uitest/voice.log || true
  kill "$app" 2>/dev/null || true
  wait "$app" 2>/dev/null || true
done
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
exit "${failed:-0}"
