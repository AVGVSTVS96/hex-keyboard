#!/bin/bash
# Runs on the Mac. OPEN=1 unfolds the iPhone Duo first. The bar, the pills and the emoji panel through the real keyboard, light and dark, screenshotting
# each step into shots/raw/look/: scripts/looktest ["iPhone Duo"] [iPhone-Duo] (RUNTIME picks the iOS; ORIENTATION=landscape; COMPACT=1 turns on Compact Emoji & GIFs)
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone 17}
TYPE=${2:-iPhone-17}
export APP=build/uitest/Build/Products/Debug-iphonesimulator/Hex.app
ID=$(scripts/sim ensure "$NAME" "$TYPE")
slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')
mkdir -p shots/raw/look
xcodegen generate -q
xcodebuild build-for-testing -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet 2>&1 | grep -E "error" || true
scripts/sim boot "$ID"
scripts/sim use "$ID" hex
[ -n "${OPEN:-}" ] && scripts/sim unfold "$ID"
for appearance in ${APPEARANCES:-light dark}; do
  xcrun simctl terminate "$ID" com.shahidy.hexkeyboard 2>/dev/null || true
  xcrun simctl ui "$ID" appearance "$appearance"
  sleep 3
  TEST_RUNNER_HEX_SHOTS="$PWD/shots/raw/look/$slug-${ORIENTATION:-portrait}${COMPACT:+-compact}-$appearance" TEST_RUNNER_HEX_ORIENTATION="${ORIENTATION:-portrait}" TEST_RUNNER_HEX_COMPACT="${COMPACT:-}" \
    xcodebuild test-without-building -project HexKeyboard.xcodeproj -scheme Hex -destination "id=$ID" \
    -derivedDataPath build/uitest -only-testing:HexUITests/PanelTests > build/uitest/look.log 2>&1 || true
  grep -E "error:|XCTAssert|Test Case .*(passed|failed)|Executed" build/uitest/look.log || true
done
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
