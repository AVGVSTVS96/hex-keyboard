#!/bin/bash
# Runs on the Mac. A source through the real keyboard, with scripts/source.py standing in for it; prints what it was
# sent: scripts/sourcetest ["iPhone Duo"] [iPhone-Duo]
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
PORT=${PORT:-2599}
ID=$(scripts/sim ensure "$NAME" "$TYPE")
scripts/sim boot "$ID"
scripts/sim use "$ID" iikb
scripts/sim allow "$ID"
slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')
mkdir -p shots/raw/source build/uitest
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet
xcrun simctl install "$ID" build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
log=build/uitest/source.jsonl
: > "$log"
/usr/bin/python3 scripts/source.py "$PORT" "$log" &
source=$!
trap 'kill $source 2>/dev/null || true' EXIT
TEST_RUNNER_IIKB_SOURCE="http://localhost:$PORT/iikb" TEST_RUNNER_IIKB_SHOTS="$PWD/shots/raw/source/$slug" \
  xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -only-testing:AppUITests/SourceTests > build/uitest/source.log 2>&1 || failed=1
grep -E "error:|XCTAssert|Test Case .*(passed|failed)|Executed" build/uitest/source.log || true
cat "$log"
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
exit "${failed:-0}"
