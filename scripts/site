#!/bin/sh
# Build the presentation site without the optional WebAssembly demo toolchain.
set -eu
cd "$(dirname "$0")/.."
mkdir -p web/dist
cp web/site/index.html web/site/page.css web/site/page.js web/site/favicon.svg web/site/apple-touch-icon.png web/site/icon-512.png web/site/og.png web/site/og.mp4 web/site/player.html web/dist/
cp -R web/site/fonts web/site/shots web/dist/
cp copy/facts.json web/dist/
cp brand/logo/out/wordmark-paper.svg web/dist/
