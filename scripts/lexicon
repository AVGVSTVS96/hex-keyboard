#!/bin/sh
# Rebuilds Packages/KeyboardModules/Sources/KeyboardEnglish/Resources/en.lexicon (see scripts/lexicon.py for the sources).
set -e
cd "$(dirname "$0")/.."
mkdir -p build/lexicon
uv run --no-project python3 scripts/lexicon.py build/lexicon > build/lexicon/words.tsv
scripts/tool LexiconBuilder build/lexicon/words.tsv Packages/KeyboardModules/Sources/KeyboardEnglish/Resources/en.lexicon
