#!/bin/bash
# Runs on the Mac. A transcript's recording sent from its menu in the list and from its page, light and dark, shots in
# shots/raw/share/: scripts/sharetest ["iPhone Duo"] [iPhone-Duo]. The transcript and its sound are made up here.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
ID=$(scripts/sim ensure "$NAME" "$TYPE")
slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')
mkdir -p shots/raw/share
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest -quiet
scripts/sim boot "$ID"
[ "$TYPE" = iPhone-Duo ] && scripts/sim unfold "$ID" 0
xcrun simctl install "$ID" build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
data=$(xcrun simctl get_app_container "$ID" com.shahidy.iikb data)
support="$data/Library/Application Support"
id=7C1E2A40-0F3B-4D2E-9A51-6B2C3D4E5F60
mkdir -p "$support/recordings"
say -v Samantha -o build/uitest/share.aiff "Hey, running ten minutes late, grab us a table by the window and order the dumplings."
/usr/bin/python3 - "$support" "$id" build/uitest/share.aiff <<'PY'
import json, struct, subprocess, sys, time, wave
support, id, aiff = sys.argv[1:]
raw = aiff + ".wav"
subprocess.run(["afconvert", "-f", "WAVE", "-d", "LEI16@16000", "-c", "1", aiff, raw], check=True)
data = open(raw, "rb").read()
at = data.index(b"data")
size = struct.unpack("<I", data[at + 4:at + 8])[0]
with wave.open(f"{support}/recordings/{id}.wav", "wb") as out:
    out.setnchannels(1); out.setsampwidth(2); out.setframerate(16000); out.writeframes(data[at + 8:at + 8 + size])
now = time.time() - 978307200
line = dict(id=id, date=now, text="Hey, running ten minutes late, grab us a table by the window and order the dumplings.", seconds=size / 32000,
            typed=True, model="Parakeet v3", mic="iPhone Microphone", voiceProcessing=True, app="com.apple.MobileSMS")
open(f"{support}/transcripts.jsonl", "w").write(json.dumps(line) + "\n")
PY
for appearance in light dark; do
  xcrun simctl ui "$ID" appearance "$appearance"
  TEST_RUNNER_IIKB_SHOTS="$PWD/shots/raw/share/$slug-$appearance" \
    xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
    -derivedDataPath build/uitest -only-testing:AppUITests/RecordingShareTests > build/uitest/share.log 2>&1 || failed=1
  grep -E "error:|XCTAssert|Test Case .*(passed|failed)|Executed" build/uitest/share.log || true
done
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
exit "${failed:-0}"
